# PostgreSQL (shared by mcp, scheduler, admin, api).
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news
DATABASE_URL=postgresql+psycopg://news:news@postgres:5432/news

# Source SQLite file for one-shot data migration only:
#   docker compose run --rm scheduler python -m scripts.migrate_sqlite_to_postgres
# DB_NAME=/data/dominican_news_repository.db

# Traefik Host() rule for the MCP service (must resolve to this machine).
MCP_DOMAIN=news-mcp.local

# MCP listen port inside the container (Traefik load-balances to this).
MCP_PORT=7000

# Single shared Bearer token for streamable-http / sse.
# Override in .env if needed; docker-compose defaults to this value.
MCP_API_KEY=5cfb757b93c423b4bd8fcc6c65a5139304978503d5a1be38

# CLUSTER_DESC_MAX_CHARS=800

# Traefik Host() rule for the SQLAdmin UI (must resolve to this machine).
ADMIN_DOMAIN=news-admin.local

# Admin listen port inside the container (Traefik load-balances to this).
ADMIN_PORT=7001

# SQLAdmin login (required).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# Public website API (FastAPI).
API_DOMAIN=news-api.local
API_PORT=7002
# false = serve api/mock_articles.py fixtures; true = PostgreSQL published articles.
API_USE_DB=false
WEBSITE_CORS_ORIGINS=http://localhost:7003
# SSR fetch URL from the website container (Docker service name).
WEBSITE_API_URL=http://api:7002

# Traefik Host() rule for the website (must resolve to this machine).
WEBSITE_DOMAIN=news-website.local
# Public canonical origin used for metadata, sitemap, and robots.
WEBSITE_URL=http://news-website.local

# Website listen port inside the container (Traefik load-balances to this).
WEBSITE_PORT=7003

# Preprocess: articles to cluster per run, then max clusters to describe (0 = all).
PREPROCESS_BATCH_SIZE=650
PREPROCESS_CLUSTER_LIMIT=50

# DeepInfra — cluster descriptions / category / place (preprocess)
# and verified-article cover images (FLUX).
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=Qwen/Qwen3.6-35B-A3B
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b
DEEPINFRA_IMAGE_SIZE=1024x1024
ARTICLE_IMAGE_MAX_PER_BATCH=6
ARTICLE_IMAGES_DIR=/data/article_images
# Absolute base used when storing verified_articles.image_url.
PUBLIC_API_URL=http://localhost:7002

# DeepSeek — story-audit agents only
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=4096
FINAL_ARTICLE_MAX_CHARS=1500
STORY_AUDIT_BATCH_SIZE=5
# Skip clusters whose newest member article is older than this many days.
STORY_AUDIT_MAX_AGE_DAYS=3

# Serper.dev — trusted-source evidence for the fact checker.
# SERPER_API_KEY is also accepted as a fallback.
FACT_CHECK_SEARCH_API_KEY=
# `gob.do` allows any *.gob.do host; all other entries allow their subdomains.
FACT_CHECK_TRUSTED_DOMAINS=gob.do,armando.info,ojo-publico.com,connectas.org,chequeado.com,aosfatos.org,agencialupa.com.br,verificado.mx,un.org,unicef.org,who.int,paho.org,oas.org,worldbank.org,imf.org,iadb.org,ilo.org,unesco.org
FACT_CHECK_MAX_SEARCHES_PER_CLUSTER=10
FACT_CHECK_RESULTS_PER_QUERY=3
FACT_CHECK_SEARCH_GEO=do
FACT_CHECK_SEARCH_LANG=es
FACT_CHECK_SEARCH_TIMEOUT_SECONDS=15
FACT_CHECK_SEARCH_CACHE_TTL_SECONDS=86400
