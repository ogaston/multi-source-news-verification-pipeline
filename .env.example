# Traefik Host() rule for the MCP service (must resolve to this machine).
MCP_DOMAIN=news-mcp.local

# MCP listen port inside the container (Traefik load-balances to this).
MCP_PORT=8000

# Single shared Bearer token for streamable-http / sse.
# Override in .env if needed; docker-compose defaults to this value.
MCP_API_KEY=5cfb757b93c423b4bd8fcc6c65a5139304978503d5a1be38

# Groq for Spanish cluster descriptions during preprocess.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# CLUSTER_DESC_MAX_CHARS=800

# Traefik Host() rule for the SQLAdmin UI (must resolve to this machine).
ADMIN_DOMAIN=news-admin.local

# Admin listen port inside the container (Traefik load-balances to this).
ADMIN_PORT=8001

# SQLAdmin login (required).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# Agents (story audit) — DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
FINAL_ARTICLE_MAX_CHARS=1500
STORY_AUDIT_BATCH_SIZE=5
