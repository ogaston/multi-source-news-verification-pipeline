# PostgreSQL (shared by mcp, scheduler, admin, api).
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news
DATABASE_URL=postgresql+psycopg://news:news@postgres:5432/news

# Source SQLite file for one-shot data migration only:
#   docker compose run --rm scheduler python -m scripts.migrate_sqlite_to_postgres
# DB_NAME=/data/dominican_news_repository.db

# Traefik Host() rule for the MCP service (must resolve to this machine).
MCP_DOMAIN=news-mcp.local

# MCP listen port inside the container (Traefik load-balances to this).
MCP_PORT=7000

# Single shared Bearer token for streamable-http / sse.
# Override in .env if needed; docker-compose defaults to this value.
MCP_API_KEY=5cfb757b93c423b4bd8fcc6c65a5139304978503d5a1be38

# CLUSTER_DESC_MAX_CHARS=800

# Traefik Host() rule for the SQLAdmin UI (must resolve to this machine).
ADMIN_DOMAIN=news-admin.local

# Admin listen port inside the container (Traefik load-balances to this).
ADMIN_PORT=7001

# SQLAdmin login (required).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# Public website API (FastAPI).
API_DOMAIN=news-api.local
API_PORT=7002
# false = serve api/mock_articles.py fixtures; true = PostgreSQL published articles.
API_USE_DB=false
WEBSITE_CORS_ORIGINS=http://localhost:7003
# SSR fetch URL from the website container (Docker service name).
WEBSITE_API_URL=http://api:7002

# Traefik Host() rule for the website (must resolve to this machine).
WEBSITE_DOMAIN=news-website.local

# Website listen port inside the container (Traefik load-balances to this).
WEBSITE_PORT=7003

# DeepSeek — cluster descriptions (preprocess) + story-audit agents
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=4096
FINAL_ARTICLE_MAX_CHARS=1500
STORY_AUDIT_BATCH_SIZE=5
