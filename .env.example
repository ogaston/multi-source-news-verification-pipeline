# Traefik Host() rule for the MCP service (must resolve to this machine).
MCP_DOMAIN=news-mcp.local

# MCP listen port inside the container (Traefik load-balances to this).
MCP_PORT=8000

# Single shared Bearer token for streamable-http / sse.
# Override in .env if needed; docker-compose defaults to this value.
MCP_API_KEY=5cfb757b93c423b4bd8fcc6c65a5139304978503d5a1be38
