# PostgreSQL (shared by mcp, scheduler, admin, api).
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news
POSTGRES_HOST_PORT=5436
DATABASE_URL=postgresql+psycopg://news:news@postgres:5432/news

# Pytest only (destructive drop_all/create_all). Use news_test from docker-compose.local,
TEST_DATABASE_URL=postgresql+psycopg://news:news@localhost:5432/news_test

# Host() rule for the MCP service
MCP_DOMAIN=news-mcp.local

# MCP listen port inside the container
MCP_PORT=7000
MCP_HOST=0.0.0.0
MCP_TRANSPORT=streamable-http

# Single shared Bearer token for streamable-http / sse.
MCP_API_KEY=

# Host() rule for the SQLAdmin UI
ADMIN_DOMAIN=news-admin.local

# Admin 
ADMIN_PORT=7001

# SQLAdmin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# Public API (FastAPI)
API_DOMAIN=news-api.local
API_PORT=7002
API_KEY=

# Website-API config
WEBSITE_API_KEY=
WEBSITE_CORS_ORIGINS=http://localhost:7003

# SSR fetch URL from the website container
WEBSITE_API_URL=http://api:7002

# Host() rule for the website
WEBSITE_DOMAIN=news-website.local
# Public canonical origin used for metadata, sitemap, and robots
WEBSITE_URL=http://news-website.local
# Website listen port inside the container  
WEBSITE_PORT=7003

# Storage / vector index
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=news_index_v2
STORY_CHROMA_COLLECTION=story_index
VERIFIED_CHROMA_COLLECTION=verified_index
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DATA_DIR=data
CLUSTER_DESC_MAX_CHARS=800

# Ingest and MCP query limits
DEFAULT_URL_LIMIT=100
MAX_QUERY_LIMIT=50
MAX_DAYS_BACK=365
MAX_TOPIC_LENGTH=500

# Pipeline calendar timezone (ingest timestamps + daily preprocess day window).
PIPELINE_TZ=America/Santo_Domingo

# Preprocess: articles to cluster per run
PREPROCESS_BATCH_SIZE=650
PREPROCESS_DAY_OFFSET=1
PREPROCESS_CLUSTER_LIMIT=30

# Cosine distance threshold for AHC (≈ 1 - similarity); 0.27 ≈ similarity 0.73.
CLUSTER_DISTANCE_THRESHOLD=0.27

# Homepage layout: lead + secondary (imaged) + list.
HOMEPAGE_SECONDARY_COUNT=8
HOMEPAGE_LIST_COUNT=8
# Rank by cluster importance within this many days; older stories append below.
HOMEPAGE_RANK_MAX_AGE_DAYS=3

# DeepInfra LLM (descriptions / category / place)
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=Qwen/Qwen3.6-35B-A3B
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# DeepInfra image
DEEPINFRA_IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b
DEEPINFRA_IMAGE_SIZE=1024x768
ARTICLE_IMAGE_MAX_PER_BATCH=9
ARTICLE_IMAGES_DIR=/data/article_images

# Absolute base used when storing verified_articles.image_url.
PUBLIC_API_URL=http://localhost:7002

# DeepSeek LLM (story auditing)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_MAX_RETRIES=5
DEEPSEEK_RETRY_WAIT=8
FINAL_ARTICLE_MAX_CHARS=1500
STORY_AUDIT_BATCH_SIZE=30
# Skip clusters whose newest member article is older than this many days.
STORY_AUDIT_MAX_AGE_DAYS=1

# Serper.dev — trusted-source evidence for the fact checker.
# FACT_CHECK_SEARCH_API_KEY is preferred; SERPER_API_KEY is accepted as a fallback.
FACT_CHECK_SEARCH_API_KEY=
SERPER_API_KEY=

# `gob.do` allows any *.gob.do host; all other entries allow their subdomains.
FACT_CHECK_TRUSTED_DOMAINS=gob.do,armando.info,ojo-publico.com,connectas.org,chequeado.com,aosfatos.org,agencialupa.com.br,verificado.mx,un.org,unicef.org,who.int,paho.org,oas.org,worldbank.org,imf.org,iadb.org,ilo.org,unesco.org
FACT_CHECK_MAX_SEARCHES_PER_CLUSTER=10
FACT_CHECK_RESULTS_PER_QUERY=3
FACT_CHECK_SEARCH_GEO=do
FACT_CHECK_SEARCH_LANG=es
FACT_CHECK_SEARCH_TIMEOUT_SECONDS=15
FACT_CHECK_SEARCH_CACHE_TTL_SECONDS=86400
